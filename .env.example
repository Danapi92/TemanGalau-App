# Example environment variables used by the skeleton
# Copy this file to .env and fill real values before running

# Google OAuth Client ID for Android (from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Secret used to sign backend JWTs (choose a strong random value)
JWT_SECRET=

# Example for OpenAI (if you integrate later)
OPENAI_API_KEY=

# Backend server port (optional)
PORT=8000

# If you deploy, set FRONTEND_URL to restrict CORS
FRONTEND_URL=
